{
  "name": "leo-racer",
  "version": "0.1.0",
  "private": true,
  "description": "Leo Racer — a browser driving toy for young children",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply leo-racer-alpha --local",
    "db:migrate:remote": "wrangler d1 migrations apply leo-racer-alpha --remote",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vladyslav-kramarenko/leo-racer.git"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.2",
    "@cloudflare/workers-types": "^5.20260930.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "wrangler": "^4.144.0"
  }
}
